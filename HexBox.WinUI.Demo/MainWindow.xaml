<?xml version="1.0" encoding="utf-8"?>
<WinEx:WindowEx x:Class="HexBox.WinUI.Demo.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="using:HexBox.WinUI.Demo"
                xmlns:WinEx="using:WinUIEx"
                xmlns:hb="using:HexBox.WinUI"
                xmlns:convert="using:CommunityToolkit.WinUI.Converters"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d"
                Title="HexBox.WinUI.Demo">

    <Grid VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch"
          Name="Root"
          Background="{ThemeResource AppBarBackgroundThemeBrush}">
        <Grid.Resources>
            <convert:BoolNegationConverter x:Key="BoolNegationConverter" />
            <hb:BigEndianConverter x:Key="BigEndianConverter" />
            <hb:HexboxDataFormatConverter x:Key="HexboxDataFormatConverter" />
            <hb:HexboxDataSignednessConverter x:Key="HexboxDataSignednessConverter" />
            <hb:HexboxDataTypeConverter x:Key="HexboxDataTypeConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Name="AppTitleBar"
                IsTabStop="False"
                Background="{ThemeResource AppBarBackgroundThemeBrush}">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Spacing="8">
                <AppBarSeparator></AppBarSeparator>
                <ImageIcon Source="/Assets/hexagons_32.ico"
                           Height="24" />
                <TextBlock VerticalAlignment="Center">HexBox.WinUI.Demo</TextBlock>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1"
              Background="{ThemeResource AppBarBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*" />
                <RowDefinition Height="5*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="8">
                <AppBarSeparator />
                <Button Name="Browse"
                        Click="Button_Click"
                        Content="{x:Bind LocalStrings.BrowseButton, Mode=OneWay}"></Button>
                <RichEditBox Name="Editor2"
                             Width="150" />
                <TextBox Name="FindBox"
                         Width="350"
                         PlaceholderText="{x:Bind LocalStrings.FindBox, Mode=OneWay}" />
                <TextBlock Text="{x:Bind LocalStrings.ThemeTB, Mode=OneWay}"
                           VerticalAlignment="Center" />
                <ComboBox Name="ThemeBox"
                          Width="120">
                    <ComboBoxItem Content="As System"
                                  Tag="0" />
                    <ComboBoxItem Content="Light Theme"
                                  Tag="1" />
                    <ComboBoxItem Content="Dark Theme"
                                  Tag="2" />
                </ComboBox>
                <TextBlock Text="{x:Bind LocalStrings.LangTB, Mode=OneWay}"
                           VerticalAlignment="Center" />
                <ComboBox Name="LanguageBox"
                          Width="120">
                    <ComboBoxItem Content="Default"
                                  Tag="Default" />
                    <ComboBoxItem Content="en-US"
                                  Tag="en-US" />
                    <ComboBoxItem Content="de"
                                  Tag="de" />
                    <ComboBoxItem Content="ja"
                                  Tag="ja" />
                    <ComboBoxItem Content="zh-hant"
                                  Tag="zh-hant" />
                    <ComboBoxItem Content="zh-hans"
                                  Tag="zh-hans" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="8">
                <AppBarSeparator />
                <CheckBox VerticalContentAlignment="Center"
                          Name="EnforceModeCheckBox"
                          Content="{x:Bind LocalStrings.FixedView, Mode=OneWay}"
                          IsChecked="{x:Bind FixedMode, Mode=TwoWay}" />
                <CheckBox VerticalContentAlignment="Center"
                          Name="ShowHeaderCheckBox"
                          Content="{x:Bind LocalStrings.ShowHeader, Mode=OneWay}"
                          IsChecked="{x:Bind ShowHeader, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind LocalStrings.Columns, Mode=OneWay}" VerticalAlignment="Center" />
                    <TextBlock Foreground="Red"
                               Text="{x:Bind Columns, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0" />
                </StackPanel>
                <Slider Value="{x:Bind Columns, Mode=OneWay}"
                        Minimum="8"
                        Maximum="64"
                        StepFrequency="8"
                        Name="ColumnsSlider"
                        Width="100"
                        ValueChanged="ColumnsSlider_ValueChanged"></Slider>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind LocalStrings.FileSize, Mode=OneWay}" VerticalAlignment="Center" />
                    <TextBlock Foreground="Red"
                               Text="{x:Bind FileSize, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <hb:HexBox  Grid.Row="2"
                    x:Name="HexViewer"
                    Columns="{x:Bind Columns, Mode=OneWay}"
                    Margin="4"
                    BorderBrush="#6D6D6D"
                    Background="Transparent"
                    FixedMode="{x:Bind FixedMode, Mode=OneWay}"
                    ShowHeader="{x:Bind ShowHeader, Mode=OneWay}"
                    BorderThickness="1"
                    FontFamily="Monaco"
                    FontSize="14">
            <hb:HexBox.ContextMenuFlyout>
                <MenuFlyout>
                    <MenuFlyout.Items>
                        <MenuFlyoutItem Icon="Copy"
                                        Text="Copy"
                                        Command="{Binding CopyCommand}" />
                        <MenuFlyoutItem Icon="Font"
                                        Text="Copy Text"
                                        Command="{Binding CopyTextCommand}" />
                        <MenuFlyoutItem Icon="SelectAll"
                                        Text="Select All"
                                        Command="{Binding SelectAllCommand}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem Text="Address">
                            <ToggleMenuFlyoutItem Text="Hide Address"
                                                  IsChecked="{Binding ShowAddress, Mode=TwoWay, Converter={StaticResource BoolNegationConverter}}" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem Text="Data">
                            <ToggleMenuFlyoutItem Text="Hide Data"
                                                  IsChecked="{Binding ShowData, Mode=TwoWay, Converter={StaticResource BoolNegationConverter}}" />
                            <RadioMenuFlyoutItem GroupName="DataType"
                                                 Text="1-Byte Integer"
                                                 IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource HexboxDataTypeConverter}, ConverterParameter=Int_1}" />
                            <RadioMenuFlyoutItem GroupName="DataType"
                                                 Text="2-Byte Integer"
                                                 IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource HexboxDataTypeConverter}, ConverterParameter=Int_2}" />
                            <RadioMenuFlyoutItem GroupName="DataType"
                                                 Text="4-Byte Integer"
                                                 IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource HexboxDataTypeConverter}, ConverterParameter=Int_4}" />
                            <RadioMenuFlyoutItem GroupName="DataType"
                                                 Text="8-Byte Integer"
                                                 IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource HexboxDataTypeConverter}, ConverterParameter=Int_8}" />
                            <RadioMenuFlyoutItem GroupName="DataType"
                                                 Text="4-Byte Float"
                                                 IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource HexboxDataTypeConverter}, ConverterParameter=Float_32}" />
                            <RadioMenuFlyoutItem GroupName="DataType"
                                                 Text="8-Byte Float"
                                                 IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource HexboxDataTypeConverter}, ConverterParameter=Float_64}" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem Text="Signed"
                                                  IsChecked="{Binding DataSignedness, Mode=TwoWay, Converter={StaticResource HexboxDataSignednessConverter}, ConverterParameter=Signed}" />
                            <ToggleMenuFlyoutItem Text="Unsigned"
                                                  IsChecked="{Binding DataSignedness, Mode=TwoWay, Converter={StaticResource HexboxDataSignednessConverter}, ConverterParameter=Unsigned}" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem Text="Decimal"
                                                  IsChecked="{Binding DataFormat, Mode=TwoWay, Converter={StaticResource HexboxDataFormatConverter}, ConverterParameter=Decimal}" />
                            <ToggleMenuFlyoutItem Text="Hexadecimal"
                                                  IsChecked="{Binding DataFormat, Mode=TwoWay, Converter={StaticResource HexboxDataFormatConverter}, ConverterParameter=Hexadecimal}" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem Text="Big Endian"
                                                  IsChecked="{Binding Endianness, Mode=TwoWay, Converter={StaticResource BigEndianConverter}, ConverterParameter=BigEndian}" />
                            <ToggleMenuFlyoutItem Text="Little Endian"
                                                  IsChecked="{Binding Endianness, Mode=TwoWay, Converter={StaticResource BigEndianConverter}, ConverterParameter=LittleEndian}" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem Text="Text">
                            <ToggleMenuFlyoutItem Text="Hide Text"
                                                  IsChecked="{Binding ShowText, Mode=TwoWay, Converter={StaticResource BoolNegationConverter}}" />
                            <ToggleMenuFlyoutItem Text="ASCII"
                                                  IsChecked="{Binding ShowText, Mode=TwoWay}"
                                                  IsEnabled="False" />
                        </MenuFlyoutSubItem>
                    </MenuFlyout.Items>
                </MenuFlyout>
            </hb:HexBox.ContextMenuFlyout>
        </hb:HexBox>
    </Grid>
</WinEx:WindowEx>